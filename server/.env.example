# Copy to .env. Never commit .env or put the Gemini key in the iPhone app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared rolling 24-hour cap for ALL AI attempts, including failures. Set 0 to pause.
DAILY_REVIEW_LIMIT=30
# Includes thought + answer tokens. Truncated responses never earn rewards.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Generate a long random token and put the SAME token in the iPhone AI connection screen.
RECYCLI_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/verification.sqlite
# For your iPhone on the same trusted Wi-Fi or hotspot, set HOST=:: for IPv4 + IPv6.
# Use your Mac's .local name or its direct network address.
