{
  "expo": {
    "name": "EcoGotchi",
    "slug": "ecogotchi-orion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2f0d9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cabb007.ecogotchi",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your EcoGotchi review server on trusted Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.cabb007.ecogotchi"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Capture three recycling photos. Demo keeps them on your phone; AI mode uploads only when you send for review.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }]
    ]
  }
}
